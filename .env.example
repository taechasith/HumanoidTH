DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_POSTGRES_API_KEY"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Used for canonical URLs, sitemap and Open Graph (read by lib/seo.ts).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Network graph source mode: auto, file, database, or hybrid.
NETWORK_GRAPH_SOURCE="auto"
NETWORK_GRAPH_IMPORT_FILE_PATH="data/imports/thailand_humanoid_atlas_seed_records.json"

# Admin sign-in (/admin-login) and Basic auth for /api/ingest/* and /api/export.
# There are no built-in defaults: if these are unset, nobody can sign in as admin.
ADMIN_BASIC_USER="admin@example.com"
ADMIN_BASIC_PASSWORD="change-this-before-deploy"
# Signs the admin session cookie. Optional: falls back to ADMIN_BASIC_PASSWORD. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# Optional ingestion keys. Leave blank to use public/no-key endpoints where available.
YOUTUBE_API_KEY=""
GITHUB_TOKEN=""

# Living Lab identity (email verification, /living-lab only). See docs/hri-living-lab-identity-design.md.
# Signs participant sessions and hashes one-time codes. Required in production. Generate with: openssl rand -base64 32
HRI_IDENTITY_SECRET=""
# Email verification before a passport is created. Default: required. Set to "false" only as the
# event-day fallback when EmailJS cannot send (quota or outage); passports from unverified visitors then
# have no owner. Changing it on Vercel needs a redeploy.
HRI_IDENTITY_REQUIRED="false"
# EmailJS, called from the server only (never NEXT_PUBLIC_). In the EmailJS dashboard enable
# Account -> Security -> "Allow EmailJS API for non-browser applications".
# Template: To Email = {{to_email}}; body uses {{passcode}} and {{expires_minutes}}.
# Without these, local dev prints the code in the server terminal; production reports the feature unavailable.
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID_TH=""
EMAILJS_TEMPLATE_ID_EN=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""
